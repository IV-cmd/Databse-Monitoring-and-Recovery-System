# CERN Database Monitoring System - Development Configuration
# Copy this file to .env and update with your actual values

# Environment and Core Settings
DB_MONITOR_ENVIRONMENT=development
DB_MONITOR_DEBUG=false
DB_MONITOR_LOG_LEVEL=INFO
DB_MONITOR_SECRET_KEY=your-secret-key-here-32-chars-minimum

# Database Configuration
DB_MONITOR_DATABASE_URL=postgresql://admin:admin123@localhost:5432/monitoring_db
DB_MONITOR_REPLICA_URL=postgresql://admin:admin123@localhost:5432/monitoring_db

# Database SSL Settings
DB_MONITOR_DB_SSL_ENABLED=false
DB_MONITOR_DB_SSL_CERT_FILE=
DB_MONITOR_DB_SSL_KEY_FILE=
DB_MONITOR_DB_SSL_CA_FILE=
DB_MONITOR_DB_SSL_VERIFY=disable
DB_MONITOR_DB_CONNECTION_TIMEOUT=30.0
DB_MONITOR_DB_COMMAND_TIMEOUT=60.0
DB_MONITOR_DB_MAX_CONNECTIONS=100
DB_MONITOR_DB_MIN_CONNECTIONS=10

# Monitoring Configuration
DB_MONITOR_PROMETHEUS_URL=http://localhost:9090
DB_MONITOR_PROMETHEUS_USERNAME=
DB_MONITOR_PROMETHEUS_PASSWORD=
DB_MONITOR_PROMETHEUS_AUTH_REQUIRED=false
DB_MONITOR_PROMETHEUS_BEARER_TOKEN=
DB_MONITOR_PROMETHEUS_TIMEOUT=30.0
DB_MONITOR_MONITOR_INTERVAL=30
DB_MONITOR_HEALTH_CHECK_INTERVAL=10

# Recovery Configuration
DB_MONITOR_AUTO_RECOVERY_ENABLED=true
DB_MONITOR_MAX_RECOVERY_ATTEMPTS=3
DB_MONITOR_RECOVERY_TIMEOUT=300
DB_MONITOR_RECOVERY_AUTH_REQUIRED=false
DB_MONITOR_RECOVERY_BEARER_TOKEN=

# API Configuration
DB_MONITOR_API_PREFIX=/api/v1
DB_MONITOR_ALLOWED_ORIGINS=*
DB_MONITOR_ALLOWED_HOSTS=*
DB_MONITOR_RATE_LIMIT_PER_MINUTE=100
DB_MONITOR_LOG_REQUEST_BODY=false

# Monitoring Thresholds
DB_MONITOR_CPU_WARNING_THRESHOLD=80.0
DB_MONITOR_CPU_CRITICAL_THRESHOLD=95.0
DB_MONITOR_MEMORY_WARNING_THRESHOLD=85.0
DB_MONITOR_MEMORY_CRITICAL_THRESHOLD=95.0
DB_MONITOR_DISK_WARNING_THRESHOLD=85.0
DB_MONITOR_DISK_CRITICAL_THRESHOLD=95.0

# Database Performance Thresholds
DB_MONITOR_SLOW_QUERY_THRESHOLD=1.0
DB_MONITOR_MAX_CONNECTIONS=100
DB_MONITOR_REPLICATION_LAG_THRESHOLD=10.0

# Metrics Collection Configuration
DB_MONITOR_METRICS_COLLECTION_INTERVAL=5
DB_MONITOR_MONITORING_INTERVAL_SECONDS=30
DB_MONITOR_SLOW_QUERIES_DEFAULT_LIMIT=10
DB_MONITOR_SLOW_QUERIES_THRESHOLD_MS=1000.0
