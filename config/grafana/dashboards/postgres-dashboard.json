{
  "overwrite": true,
  "folderId": 0,
  "dashboard": {
    "uid": "postgres-db",
    "title": "PostgreSQL Monitoring Dashboard",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "timezone": "browser",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "tags": [
      "postgres",
      "monitoring"
    ],
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "DB Connections",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "background",
          "graphMode": "area",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 80
                },
                {
                  "color": "red",
                  "value": 150
                }
              ]
            },
            "mappings": [],
            "unit": "short",
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_stat_database_numbackends{datname=\"monitoring_db\"}",
            "legendFormat": "connections",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "DB Size",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            },
            "mappings": []
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_database_size_bytes{datname=\"monitoring_db\"}",
            "legendFormat": "size",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Cache Hit Ratio",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "background",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.9
                },
                {
                  "color": "green",
                  "value": 0.99
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            },
            "mappings": []
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_stat_database_blks_hit{datname=\"monitoring_db\"} / (pg_stat_database_blks_hit{datname=\"monitoring_db\"} + pg_stat_database_blks_read{datname=\"monitoring_db\"} + 1)",
            "legendFormat": "cache hit",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Postgres Up",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              },
              {
                "type": "special",
                "options": {
                  "match": "null",
                  "result": {
                    "text": "N/A",
                    "color": "gray"
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_up",
            "legendFormat": "status",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Active Connections Over Time",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineInterpolation": "linear",
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_stat_database_numbackends{datname=\"monitoring_db\"}",
            "legendFormat": "active",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Query Rate (per second)",
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineInterpolation": "linear",
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_xact_commit{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "commits/s",
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_xact_rollback{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "rollbacks/s",
            "refId": "B"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Rows Read / Written",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineInterpolation": "linear",
              "fillOpacity": 5
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_tup_fetched{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "rows fetched/s",
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_tup_inserted{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "rows inserted/s",
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_tup_updated{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "rows updated/s",
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "rate(pg_stat_database_tup_deleted{datname=\"monitoring_db\"}[5m])",
            "legendFormat": "rows deleted/s",
            "refId": "D"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Replication Lag (seconds)",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineInterpolation": "linear",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "expr": "pg_replication_lag",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      }
    ],
    "templating": {
      "list": [
        {
          "type": "datasource",
          "name": "datasource",
          "label": "Data Source",
          "pluginId": "prometheus",
          "current": {},
          "hide": 0
        }
      ]
    }
  }
}